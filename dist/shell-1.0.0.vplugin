{"format":"vetro-plugin","version":1,"manifest":{"id":"shell","name":"Shell","version":"1.0.0","apiVersion":1,"permissions":["exec"],"main":"index.js","ui":{"label":"Shell"},"description":"A root shell on the TV from the dashboard, one command at a time; cd is remembered.","author":"Pierfrancesco Cifra"},"files":{"index.js":"'use strict';\n// Shell: runs one command at a time on the TV as root (ctx.execute, the same path as Vetro's own commands).\n// Each command gets a fresh shell, so only the working directory is carried over: the command runs in the cwd the\n// page sends, and the cwd it ends in comes back after a marker line with a per-request nonce (a command cannot\n// fake it). bash is used when the TV has it, sh otherwise. stdin is /dev/null so a command waiting for input ends\n// instead of holding Vetro's command queue until the time limit. Plain ES5: older TVs run Node 4.4.\nvar crypto = require('crypto'), fs = require('fs'), path = require('path');\nvar DEFAULT_TIMEOUT = 30000, MAX_TIMEOUT = 120000, MAX_COMMAND = 16384, MAX_OUTPUT = 262144, MAX_HISTORY = 200, MAX_BODY = 32768;\n\nfunction quote(s) { return \"'\" + String(s).replace(/'/g, \"'\\\\''\") + \"'\"; }\nfunction validCwd(cwd) { return typeof cwd === 'string' && cwd.charAt(0) === '/' && cwd.length <= 4096 && !/[\\0\\n\\r]/.test(cwd); }\n\nfunction build(p) {\n    p = p || {};\n    var cmd = p.cmd, cwd = p.cwd == null ? '/' : p.cwd, timeout = p.timeout == null ? DEFAULT_TIMEOUT : p.timeout;\n    if (typeof cmd !== 'string' || !cmd.trim()) throw new Error('Missing command');\n    if (cmd.length > MAX_COMMAND) throw new Error('Command too long');\n    if (!validCwd(cwd)) throw new Error('Invalid working directory');\n    if (typeof timeout !== 'number' || !(timeout >= 1000) || timeout > MAX_TIMEOUT) throw new Error('Time limit must be 1–120 seconds');\n    var nonce = crypto.randomBytes(8).toString('hex'), marker = '__VETRO_CWD_' + nonce + '__';\n    var shown = cwd.replace(/[^\\x20-\\x7e]/g, '?').replace(/[\"$`\\\\]/g, '?');\n    var script = 'cd ' + quote(cwd) + ' 2>/dev/null || { echo \"cd: ' + shown + ': not found, using /\" >&2; cd /; }\\n' +\n        cmd + '\\n__vetro_status=$?\\nprintf \"\\\\n' + marker + '%s\\\\n\" \"$(pwd)\"\\nexit $__vetro_status\\n';\n    var b64 = Buffer.from(script).toString('base64');\n    var command = '__vetro_script=\"$(echo ' + b64 + ' | base64 -d)\"; if command -v bash >/dev/null 2>&1; then exec bash -c \"$__vetro_script\" </dev/null; else exec sh -c \"$__vetro_script\" </dev/null; fi';\n    return { command: command, nonce: nonce, timeout: Math.round(timeout), cwd: cwd };\n}\n\nfunction cap(s) { s = String(s || ''); return s.length > MAX_OUTPUT ? { text: s.slice(0, MAX_OUTPUT), truncated: true } : { text: s, truncated: false }; }\n\nfunction parse(r, job) {\n    r = r || {};\n    var out = String(r.stdout || ''), marker = '\\n__VETRO_CWD_' + job.nonce + '__', i = out.lastIndexOf(marker), cwd = job.cwd;\n    if (i >= 0) {\n        var rest = out.slice(i + marker.length), nl = rest.indexOf('\\n'), found = nl < 0 ? rest : rest.slice(0, nl);\n        if (validCwd(found)) cwd = found;\n        out = out.slice(0, i) + rest.slice(nl < 0 ? rest.length : nl + 1);\n    }\n    var so = cap(out), se = cap(r.stderr);\n    return { ok: r.exit_code === 0 && !r.timed_out, exit_code: r.exit_code, timed_out: !!r.timed_out, stdout: so.text, stderr: se.text, truncated: so.truncated || se.truncated, cwd: cwd };\n}\n\nfunction run(execute, p) {\n    var job;\n    try { job = build(p); } catch (e) { return Promise.reject(e); }\n    return execute(job.command, job.timeout).then(function (r) { return parse(r, job); });\n}\n\nfunction json(res, body, code) {\n    res.writeHead(code || 200, { 'content-type': 'application/json', 'cache-control': 'no-store' });\n    res.end(JSON.stringify(body));\n}\nfunction readJson(req, cb) {\n    var chunks = [], size = 0, done = false;\n    req.on('data', function (c) { size += c.length; if (size > MAX_BODY) { if (!done) { done = true; cb(new Error('Request too large')); } req.destroy && req.destroy(); return; } chunks.push(c); });\n    req.on('end', function () { if (done) return; done = true; var p; try { p = JSON.parse(Buffer.concat(chunks).toString('utf8') || '{}'); } catch (e) { return cb(new Error('Invalid JSON')); } if (!p || typeof p !== 'object' || Array.isArray(p)) return cb(new Error('Invalid JSON')); cb(null, p); });\n    req.on('error', function (e) { if (!done) { done = true; cb(e); } });\n}\n\nmodule.exports = function (ctx) {\n    var page = null, busy = false, runs = 0, lastCwd = '/';\n    function history() { var h = ctx.config.get().history; return Array.isArray(h) ? h.filter(function (x) { return typeof x === 'string'; }) : []; }\n    function remember(cmd, cwd) {\n        var c = ctx.config.get(), h = history();\n        if (h[h.length - 1] !== cmd) h.push(cmd);\n        c.history = h.slice(-MAX_HISTORY); c.cwd = cwd;\n        try { ctx.config.set(c); } catch (e) { /* history is a convenience */ }\n    }\n    return {\n        start: function () { page = fs.readFileSync(path.join(ctx.dir, 'ui.html'), 'utf8'); lastCwd = validCwd(ctx.config.get().cwd) ? ctx.config.get().cwd : '/'; },\n        stop: function () { page = null; },\n        status: function () { return { commands: runs, cwd: lastCwd, running: busy }; },\n        route: function (req, res, sub) {\n            if (sub === 'ui' && req.method === 'GET') {\n                res.writeHead(200, { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store' });\n                res.end(page || '');\n                return true;\n            }\n            if (sub === 'state' && req.method === 'GET') { json(res, { cwd: lastCwd, history: history(), busy: busy }); return true; }\n            if (sub === 'history' && req.method === 'DELETE') { var c = ctx.config.get(); c.history = []; ctx.config.set(c); json(res, { ok: true }); return true; }\n            if (sub === 'run' && req.method === 'POST') {\n                readJson(req, function (err, p) {\n                    if (err) return json(res, { ok: false, error: err.message }, 400);\n                    if (busy) return json(res, { ok: false, error: 'A command is already running' }, 409);\n                    try { build(p); } catch (e) { return json(res, { ok: false, error: e.message }, 400); }\n                    busy = true;\n                    run(ctx.execute, p).then(function (d) {\n                        runs++; lastCwd = d.cwd; remember(p.cmd, d.cwd); json(res, d);\n                    }, function (e) {\n                        json(res, { ok: false, error: String(e && e.message || e) }, 503);\n                    }).then(function () { busy = false; }, function () { busy = false; });\n                });\n                return true;\n            }\n            return false;\n        }\n    };\n};\nmodule.exports.build = build;\nmodule.exports.parse = parse;\nmodule.exports.run = run;\n","ui.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\"><title>Shell</title>\n<style>\n:root{--bg:#080f23;--surface:#101c35;--border:#344360;--text:#f5f8ff;--muted:#aab8d1;--accent:#8fbaff;--danger:#ef8a80;--mono:ui-monospace,SFMono-Regular,Consolas,monospace}\n@media (prefers-color-scheme:light){:root{--bg:#f5f8ff;--surface:#fff;--border:#c9d3e6;--text:#0b1430;--muted:#4a5878;--accent:#123bb5;--danger:#b3261e}}\n*{box-sizing:border-box}body{margin:0;padding:16px;background:var(--bg);color:var(--text);font:14px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\np{margin:0 0 8px;color:var(--muted);font-size:12px}code{font-family:var(--mono)}\n#out{margin:8px 0 0;min-height:260px;max-height:62vh;overflow:auto;padding:12px;background:var(--surface);border:1px solid var(--border);border-radius:8px;font:12px/1.5 var(--mono);white-space:pre-wrap;word-break:break-all}\n.cmd{color:var(--accent)}.err{color:var(--danger)}.note{color:var(--muted)}\nform{display:flex;align-items:center;gap:8px;margin:8px 0;padding:0 12px;border:1px solid var(--border);border-radius:8px;background:var(--surface);font:12px/1.5 var(--mono)}\nform:focus-within{outline:2px solid var(--accent);outline-offset:2px}\n#prompt{color:var(--accent);white-space:nowrap;max-width:50%;overflow:hidden;text-overflow:ellipsis}\n#cmd{flex:1;min-width:0;height:40px;border:0;background:transparent;color:inherit;font:inherit;outline:none}\n.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}\nbutton,select{height:36px;padding:0 14px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:inherit;font:inherit;cursor:pointer}\nbutton.primary{background:#123bb5;border-color:#123bb5;color:#f5f8ff;font-weight:600}button:disabled{opacity:.5;cursor:default}\nlabel{margin-left:auto;color:var(--muted);font-size:12px}\n</style></head><body>\n<p>Runs commands on the TV as root, one at a time. Each command starts a fresh shell (bash if the TV has it): <code>cd</code> is remembered, variables and aliases are not. Programs that need a terminal or keyboard input (<code>vi</code>, <code>top</code>, <code>less</code>) do not work; use <code>top -b -n 1</code>, <code>cat</code> and the like. Other Vetro actions wait while a command runs.</p>\n<p>Anyone who can use this dashboard can use this shell. A command can damage the TV's system: read it before you run it.</p>\n<pre id=\"out\" tabindex=\"0\" aria-live=\"polite\" aria-label=\"Shell output\"></pre>\n<form id=\"f\" autocomplete=\"off\"><label for=\"cmd\" id=\"prompt\" style=\"margin:0;font-size:inherit\">root@tv:/#</label><input id=\"cmd\" spellcheck=\"false\" autocapitalize=\"off\" autocomplete=\"off\" aria-label=\"Command\" autofocus></form>\n<div class=\"row\"><button id=\"run\" class=\"primary\" type=\"submit\" form=\"f\">Run</button><button id=\"clear\" type=\"button\">Clear</button>\n<label>Time limit <select id=\"limit\"><option value=\"10\">10 s</option><option value=\"30\" selected>30 s</option><option value=\"60\">60 s</option><option value=\"120\">120 s</option></select></label></div>\n<p style=\"margin-top:8px\">Enter runs · ↑ ↓ history · Ctrl+L clears. Output over 256 KB is cut.</p>\n<script>\nvar cwd='/',busy=false,hist=[],pos=0,MAXNODES=500;\nfunction $(id){return document.getElementById(id)}\nfunction prompt(){$('prompt').textContent='root@tv:'+cwd+'#'}\nfunction print(t,c){if(!t)return;var o=$('out'),s=document.createElement('span');if(c)s.className=c;s.textContent=t;o.appendChild(s);while(o.childNodes.length>MAXNODES)o.removeChild(o.firstChild);o.scrollTop=o.scrollHeight}\nfunction nl(t){return t&&t.charAt(t.length-1)!=='\\n'?t+'\\n':t}\nfunction api(u,b){return fetch(u,b===undefined?{}:{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)}).then(function(r){return r.json().then(function(d){if(!r.ok&&!d.stdout&&d.error)throw new Error(d.error);return d})})}\napi('state').then(function(d){cwd=d.cwd||'/';hist=d.history||[];pos=hist.length;prompt()}).catch(function(){prompt()});\n$('f').onsubmit=function(e){e.preventDefault();var cmd=$('cmd').value;if(busy||!cmd.trim())return;\n if(hist[hist.length-1]!==cmd)hist.push(cmd);pos=hist.length;$('cmd').value='';\n if(cmd.trim()==='clear'){$('out').textContent='';return}\n print('root@tv:'+cwd+'# '+cmd+'\\n','cmd');busy=true;$('cmd').disabled=$('run').disabled=true;\n api('run',{cmd:cmd,cwd:cwd,timeout:Number($('limit').value)*1000}).then(function(d){\n  print(nl(d.stdout));print(nl(d.stderr),'err');\n  if(d.timed_out)print('Stopped after '+$('limit').value+' s (time limit).\\n','note');else if(d.exit_code)print('exit '+d.exit_code+'\\n','note');\n  if(d.truncated)print('Output cut at 256 KB.\\n','note');if(d.cwd)cwd=d.cwd;\n }).catch(function(e){print('Not run: '+e.message+'\\n','err')}).then(function(){busy=false;$('cmd').disabled=$('run').disabled=false;prompt();$('cmd').focus()})};\n$('cmd').onkeydown=function(e){\n if(e.key==='ArrowUp'&&pos>0){e.preventDefault();this.value=hist[--pos]}\n else if(e.key==='ArrowDown'){e.preventDefault();pos=Math.min(hist.length,pos+1);this.value=hist[pos]||''}\n else if(e.key==='l'&&e.ctrlKey){e.preventDefault();$('out').textContent=''}};\n$('clear').onclick=function(){$('out').textContent='';$('cmd').focus()};\nprompt();\n</script></body></html>\n"}}
